# Required credential: load a CoreWeave API access token from your secret manager into the process environment; do not store it here.
# CWSANDBOX_API_KEY="[COREWEAVE-API-ACCESS-TOKEN]"
# Required credential: load your inference API key from your secret manager into the process environment; W&B keys originate at https://wandb.ai/authorize.
# MODEL_API_KEY="[INFERENCE-API-KEY]"
# Required: OpenAI-compatible Chat Completions base URL reachable from the sandbox.
MODEL_BASE_URL="https://api.inference.wandb.ai/v1"
# Required: tool-calling model ID available at your endpoint; this is an example.
MODEL_NAME="openai/gpt-oss-120b"
# Optional: W&B team/project for the OpenAI-Project header; omit for other providers.
MODEL_PROJECT="[WANDB-TEAM]/[WANDB-PROJECT]"
