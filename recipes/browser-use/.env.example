# Required: W&B API key for sandbox compute and inference; https://wandb.ai/authorize.
# Load WANDB_API_KEY into your process environment from your secret manager.
# Required: W&B team slug, not the organization slug; https://wandb.ai/home.
WANDB_ENTITY="[WANDB-TEAM]"
# Optional: project for inference usage tracking; https://docs.wandb.ai/inference/examples.
WANDB_PROJECT="browser-use"
