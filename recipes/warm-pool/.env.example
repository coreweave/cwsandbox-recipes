# Choose credentials using the serverless getting-started guide:
# https://docs.coreweave.com/products/sandboxes/get-started#run-a-sandbox-on-serverless-capacity

# Required for AuthStrategy.COREWEAVE_API_KEY: CoreWeave API access token from the guide.
# CWSANDBOX_API_KEY=replace-me

# Required for AuthStrategy.WANDB unless already logged in to W&B: W&B API key from the guide.
# WANDB_API_KEY=replace-me
