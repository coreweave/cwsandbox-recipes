# Copy to .env and fill in. Do not commit .env.
# `uv run async-grpo` reads it; values already in the environment win.

# --- Required ---

# CoreWeave API access token for sandboxes, inference requests and hot-loads
# (Inference Admin role). From https://console.coreweave.com/tokens
CWSANDBOX_API_KEY=
# Name of the sandbox runner you created from infra/runner.yaml.example.
CWSANDBOX_RUNNER_ID=
# Your directory on SUNK's shared filesystem. Runs and caches go under <dir>/async-grpo-tool-use.
SUNK_DATA_DIR=/mnt/data/<you>

# --- SUNK access ---

# ssh host or ~/.ssh/config alias of the SUNK login node.
SUNK_SSH_HOST=sunk
# Private key for SUNK. Set it if ssh offers too many other keys first.
# SUNK_SSH_KEY=~/.ssh/id_ed25519
# Slurm partition with 8x H100 nodes.
# SUNK_PARTITION=h100

# --- Dedicated Inference and object storage ---

# Bucket for the model and the hot-load snapshots. The inference service must be able to
# read <bucket>/<prefix>/.
# HOTLOAD_BUCKET=gradient-hotloading
# HOTLOAD_BUCKET_PREFIX=cookbook/async-grpo-tool-use
# Gateway zone, instance type and replicas (1 GPU each) of the deployment.
# INFERENCE_ZONE=US-WEST-04A
# INFERENCE_INSTANCE_TYPE=gd-8xh100ib-i128
# INFERENCE_REPLICAS=2

# --- W&B and Weave (optional, recommended) ---

# Turns on the W&B run, the Agent Lens traces and the Weave evaluations, and their links on
# the dashboard. From https://wandb.ai/authorize
# WANDB_API_KEY=
# Defaults to the key's own entity.
# WANDB_ENTITY=
# WANDB_PROJECT=async-grpo-tool-use
# Share of training rollouts traced to Agent Lens (default 1/16). Eval rollouts are always traced.
# AGENT_LENS_SAMPLE=0.0625

# --- Rollout sandboxes ---

# One sandbox per rollout. The pool starts SANDBOX_POOL_MIN sandboxes and grows to SANDBOX_POOL_MAX;
# extra sandboxes stop after SANDBOX_POOL_IDLE_S idle seconds.
# SANDBOX_POOL_MIN=256
# SANDBOX_POOL_MAX=256
# SANDBOX_POOL_IDLE_S=20
# Where rollout sandboxes run: serverless (default), cks (on your runner) or cks_then_serverless.
# SANDBOX_PLACEMENT=serverless
# Rollouts NeMo-RL keeps in flight against the Gym server.
# GYM_REMOTE_CONCURRENCY=256

# --- Run ---

# Number of GRPO steps (default 20). --max-num-steps overrides it.
# MAX_NUM_STEPS=20
# Use only the first N DAPO prompts (default: all, about 17k).
# DAPO_MAX_SAMPLES=
# Hugging Face token. The model is public; a token avoids rate limits.
# HF_TOKEN=
# Hours the shared dashboard stays up after the start (default 12). Ctrl+C stops it sooner.
# DASHBOARD_HOURS=12
