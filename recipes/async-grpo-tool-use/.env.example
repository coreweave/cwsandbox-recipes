# Copy to .env and fill in. Do not commit .env.
# `uv run async-grpo` reads it; values already in the environment win.

# --- Required ---

# CoreWeave API access token for sandboxes (and, with SAMPLER=di, inference requests and
# hot-loads: Inference Admin role). From https://console.coreweave.com/tokens
CWSANDBOX_API_KEY=

# --- Where the GPUs run: pick one option (see the README) ---

# 1. GPU sandboxes:              TRAINER=sandbox SAMPLER=vllm, plus HOTLOAD_BUCKET
# 2. SUNK + Dedicated Inference: the defaults, plus SUNK_SSH_HOST, SUNK_DATA_DIR and HOTLOAD_BUCKET
# 3. Bring your own compute:     TRAINER=sunk SAMPLER=vllm, plus SUNK_SSH_HOST and SUNK_DATA_DIR
# TRAINER=sunk
# SAMPLER=di
# Number of vLLM samplers with TRAINER=sandbox, one GPU sandbox each (default 1). Gym spreads the
# rollouts over them and the trainer loads each new export into all of them.
# SAMPLER_REPLICAS=1
# GPUs of the trainer's node that the vLLM sampler takes on Slurm (default 4; the trainer gets the rest).
# SAMPLER_GPUS=4
# Model to train. Defaults: Qwen/Qwen2.5-Math-7B on Slurm, Qwen/Qwen2.5-Math-1.5B in GPU sandboxes.
# MODEL_REPO=
# MODEL_REVISION=
# GPU type and memory of the trainer and sampler sandboxes with TRAINER=sandbox.
# GPU_SANDBOX_TYPE=rtxp6000-8x
# TRAINER_SANDBOX_MEMORY=40Gi
# SAMPLER_SANDBOX_MEMORY=32Gi

# --- SUNK access ---

# Options 2 and 3. ssh host or ~/.ssh/config alias of the Slurm login node.
# SUNK_SSH_HOST=sunk
# Your directory on the cluster's shared filesystem. Runs and caches go under <dir>/async-grpo-tool-use.
# SUNK_DATA_DIR=/mnt/data/<you>
# Private key for SUNK. Set it if ssh offers too many other keys first.
# SUNK_SSH_KEY=~/.ssh/id_ed25519
# Slurm partition with 8-GPU nodes (8x H100 for option 2).
# SUNK_PARTITION=h100
# CPUs per node the job asks for; the trainer and the sampler step each take half.
# SUNK_CPUS=112

# --- Object storage (options 1 and 2) and Dedicated Inference (option 2) ---

# Bucket for the weights the trainer sends to the sampler (and, with SAMPLER=di, the model).
# Your organization's users need write access under <bucket>/<prefix>/; with SAMPLER=di the
# inference service must also be able to read it.
# HOTLOAD_BUCKET=
# HOTLOAD_BUCKET_PREFIX=cookbook/async-grpo-tool-use
# Gateway zone, instance type and replicas (1 GPU each) of the deployment.
# INFERENCE_ZONE=US-WEST-04A
# INFERENCE_INSTANCE_TYPE=gd-8xh100ib-i128
# INFERENCE_REPLICAS=2

# --- W&B and Weave (optional, recommended) ---

# Turns on the W&B run, the Agent Lens traces and the Weave evaluations, and their links on
# the dashboard. From https://wandb.ai/authorize
# WANDB_API_KEY=
# Defaults to the key's own entity.
# WANDB_ENTITY=
# WANDB_PROJECT=async-grpo-tool-use
# Share of training rollouts traced to Agent Lens (default 1/16). Eval rollouts are always traced.
# AGENT_LENS_SAMPLE=0.0625

# --- Rollout sandboxes ---

# One fresh sandbox per rollout, stopped after it. The pool starts SANDBOX_POOL_MIN sandboxes and grows to SANDBOX_POOL_MAX;
# extra sandboxes stop after SANDBOX_POOL_IDLE_S idle seconds.
# SANDBOX_POOL_MIN=256
# SANDBOX_POOL_MAX=256
# SANDBOX_POOL_IDLE_S=20
# Sandboxes that grade the answers. They never run the model's code.
# GRADER_POOL_SIZE=8
# Optional sandbox runner on your CKS cluster (infra/runner.yaml.example). With it the Gym sandbox
# runs there; without it, on serverless capacity.
# CWSANDBOX_RUNNER_ID=
# Where rollout sandboxes run: serverless (default), cks (on your runner) or cks_then_serverless.
# SANDBOX_PLACEMENT=serverless
# Rollouts NeMo-RL keeps in flight against the Gym server.
# GYM_REMOTE_CONCURRENCY=256

# --- Run ---

# Number of GRPO steps (default 20). --max-num-steps overrides it.
# MAX_NUM_STEPS=20
# Use only the first N DAPO prompts (default: all, about 17k).
# DAPO_MAX_SAMPLES=
# Hugging Face token. The model is public; a token avoids rate limits.
# HF_TOKEN=
# Hours the shared dashboard stays up after the start (default 12). Ctrl+C stops it sooner.
# DASHBOARD_HOURS=12
