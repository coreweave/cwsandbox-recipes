CWSANDBOX_API_KEY="" # Required for --sandbox-auth coreweave (the default).
WANDB_API_KEY="" # Required for --sandbox-auth wandb; leave the unused sandbox key empty.
OPENAI_API_KEY="" # Required: application key from the OpenAI project with Agents API access.
OPENAI_EXECUTOR_API_KEY="" # Required: environment key from OpenAI Agents; same owner and project as application key.
