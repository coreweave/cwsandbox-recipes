# Required: CoreWeave API access token with SANDBOX_USER access; create it in the CoreWeave Console.
CWSANDBOX_API_KEY=replace-me
# Required: image tag in a registry you can push to; used by both CKS and Sandboxes after the build step.
TAILCAT_IMAGE=registry.example.com/your-project/tailcat-demo:0.7.0
# Required: your CKS kubeconfig context; find it with kubectl config get-contexts.
KUBE_CONTEXT=your-cks-context
