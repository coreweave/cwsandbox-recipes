# Required: CoreWeave Sandbox API key from https://console.coreweave.com.
CWSANDBOX_API_KEY=[COREWEAVE-SANDBOX-API-KEY]
# Required for model runs: W&B API key from https://wandb.ai/authorize.
WANDB_API_KEY=[WANDB-API-KEY]
# Optional: bound mini-swe-agent inference retries; each request also has two retries.
MSWEA_MODEL_RETRY_STOP_AFTER_ATTEMPT=3
# Optional: suppress mini-swe-agent startup text.
MSWEA_SILENT_STARTUP=1
