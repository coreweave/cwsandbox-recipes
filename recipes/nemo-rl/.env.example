# Required: CoreWeave API key for an organization entitled to CPU and GPU sandboxes.
CWSANDBOX_API_KEY=replace-me
# Optional: Hugging Face token if you substitute a gated model; get it from huggingface.co/settings/tokens.
HF_TOKEN=
# Optional: W&B key for the Serverless Inference path; get it from wandb.ai/authorize.
WANDB_API_KEY=
# Optional: W&B team/entity that owns versioned serverless LoRA artifacts.
WANDB_ENTITY=your-entity
# Optional: W&B project that contains versioned serverless LoRA artifacts.
WANDB_PROJECT=nemo-rl
