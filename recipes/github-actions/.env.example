# Required: CoreWeave token with SANDBOX_USER, from https://console.coreweave.com/tokens.
CWSANDBOX_API_KEY="[COREWEAVE-API-ACCESS-TOKEN]"
# Optional: Anthropic API key for --review, from https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY="[ANTHROPIC-API-KEY]"
# Optional: Anthropic model available to your account; used only with --review.
ANTHROPIC_MODEL="claude-sonnet-4-6"
